# ---------------------------------------------------------------------------------------------
# Text model (both agents). Pick any provider + model; the key comes from that provider's variable.
#   huggingface  HF_TOKEN            (default; LLM_MODEL e.g. meta-llama/Llama-3.3-70B-Instruct)
#   openai       OPENAI_API_KEY      (e.g. gpt-4o-mini)
#   google       GOOGLE_API_KEY      (Gemini, e.g. gemini-2.0-flash)
#   groq         GROQ_API_KEY        (e.g. llama-3.3-70b-versatile)
#   mistral      MISTRAL_API_KEY     (e.g. mistral-large-latest)
#   openrouter   OPENROUTER_API_KEY  (e.g. meta-llama/llama-3.3-70b-instruct)
#   together     TOGETHER_API_KEY    (e.g. meta-llama/Llama-3.3-70B-Instruct-Turbo)
#   ollama       no key, local       (e.g. llama3.1:8b; endpoint http://localhost:11434)
#   openai-compatible  any other endpoint: set LLM_ENDPOINT (+ LLM_API_KEY if it needs one)
# Model names are examples; check the provider's current model list.
# ---------------------------------------------------------------------------------------------
LLM_PROVIDER=huggingface
LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# Tried in order if the main model is not served right now (a warning is added to the result,
# since a different model may score differently). Comma-separated.
LLM_FALLBACK_MODELS=Qwen/Qwen2.5-72B-Instruct
# LLM_API_KEY=            # optional: overrides the provider's own key variable
# LLM_ENDPOINT=           # required for openai-compatible; optional URL override for others

HF_TOKEN=hf_xxx
# Hugging Face only: which inference provider serves the model. "auto" = first one enabled on your
# account (https://hf.co/settings/inference-providers); or pin one, e.g. novita, together, featherless-ai.
HF_INFERENCE_PROVIDER=auto

# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# GROQ_API_KEY=

# ---------------------------------------------------------------------------------------------
# Vision model: only used to OCR scanned resumes when Tesseract is missing or unsure.
# VLM_PROVIDER defaults to LLM_PROVIDER; the model must accept images.
# ---------------------------------------------------------------------------------------------
# VLM_PROVIDER=
VLM_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct
VLM_FALLBACK_MODELS=Qwen/Qwen2.5-VL-72B-Instruct
# VLM_HF_INFERENCE_PROVIDER=auto

# Path to the tesseract binary if it is not on PATH (Windows default install shown)
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

LLM_TEMPERATURE=0.0
LLM_SEED=42
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=3

SCORING_CONFIG=config/scoring.yaml
# Where the Streamlit UI finds the API
API_URL=http://localhost:8000
