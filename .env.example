# Hugging Face access token (https://huggingface.co/settings/tokens) with "Inference Providers" permission
HF_TOKEN=hf_xxx

# Model routed through Hugging Face Inference Providers. Any chat model works.
HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
# "auto" picks the first provider enabled on your HF account that serves the model; or pin one.
# (Qwen2.5-72B was the original model; its only fast provider, novita, stopped serving it. See docs/DEVLOG.md.)
HF_PROVIDER=auto

# Vision model used only when a resume is a scanned image and Tesseract can't read it
HF_VLM_MODEL=meta-llama/Llama-4-Scout-17B-16E-Instruct
HF_VLM_PROVIDER=auto
# Path to the tesseract binary if it is not on PATH (Windows default install shown)
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

LLM_TEMPERATURE=0.0
LLM_SEED=42
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=3

# Path to scoring weights / thresholds
SCORING_CONFIG=config/scoring.yaml

# Where the Streamlit UI finds the API
API_URL=http://localhost:8000
